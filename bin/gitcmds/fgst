#!/bin/sh

# fgst - pick entries of `git status` with sk and add, checkout or unstage them.
# Entries are `git status --porcelain` lines: "XY path", or "XY orig -> path" for
# renames (R) and copies (C). X is the index status, Y the worktree status.

# Strips the status column. Tolerates a trimmed leading space ("M file").
entry() {
  e="${1# }"
  e="${e#* }"
  echo "${e# }"
}

# The current path of an entry (the new one for renames/copies).
path() {
  e=$(entry "$1")
  echo "${e#* -> }"
}

# The index paths of an entry. Unstaging a rename needs both sides; a copy only
# the new one, as its source may carry its own staged changes.
paths() {
  case "$1" in
    R*) e=$(entry "$1") && echo "${e%% -> *}" "${e#* -> }" ;;
    *) path "$1" ;;
  esac
}

# Modes: add (worktree changes incl. untracked), worktree (tracked worktree
# changes), index (staged changes).
preview() {
  case "$2" in
    '??'*)
      file=$(path "$2")
      if [ -d "$file" ]; then
        eza -la --color always --tree "$file"
      else
        bat --color=always "$file"
      fi
      ;;
    *)
      if [ "$1" = index ]; then
        # shellcheck disable=SC2046
        git diff --color --cached --find-copies-harder -- $(paths "$2")
      else
        git diff --color -- "$(path "$2")"
      fi
      ;;
  esac
}

main() {
  case $1 in
    add) entries=$(git status --porcelain | grep -v '^. ') ;;
    worktree) entries=$(git status --porcelain | grep -v -e '^. ' -e '^??') ;;
    index) entries=$(git status --porcelain | grep -v -e '^ ' -e '^??') ;;
  esac
  [ -z "$entries" ] && exit

  echo "$entries" | sk --prompt="$2" -m --reverse --preview "'$0' preview $1 {}" |
    while IFS= read -r line; do
      if [ "$1" = index ]; then paths "$line"; else path "$line"; fi
    done
}

cd "$(git rev-parse --show-toplevel)" || exit 1

# $files is a whitespace separated path list, word splitting is intended.
# shellcheck disable=SC2086

case "$1" in
  af)
    files=$(main add '[Add Files] >')
    [ -z "$files" ] && exit
    git add $files && echo "Files added:" && echo "$files"
    ;;
  ah)
    files=$(main worktree '[Add Hunks] >')
    [ -z "$files" ] && exit
    git add --patch $files && echo "Hunks added:" && echo "$files"
    ;;
  cf)
    files=$(main worktree '[Checkout Files] >')
    [ -z "$files" ] && exit
    git checkout -- $files >/dev/null && echo "Files restored:" && echo "$files"
    ;;
  ch)
    files=$(main worktree '[Checkout Hunks] >')
    [ -z "$files" ] && exit
    git checkout -p -- $files && echo "Hunks restored:" && echo "$files"
    ;;
  uf)
    files=$(main index '[Unstage Files] >')
    [ -z "$files" ] && exit
    git reset HEAD -- $files >/dev/null && echo "Files unstaged:" && echo "$files"
    ;;
  preview) preview "$2" "$3" ;;
  *) exit 1 ;;
esac
